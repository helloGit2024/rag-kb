# ── PostgreSQL ──────────────────────────────────────────
POSTGRES_USER=ragkb
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ragkb
POSTGRES_PORT=5432

# ── Redis ───────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379
# 问答缓存有效期（秒）。T16：缓存 key 含可见范围指纹（R3），
# 不同权限绝不会命中同一份缓存；改文档后旧答案最多滞留这么久。
QA_CACHE_TTL_S=3600

# ── Backend ─────────────────────────────────────────────
BACKEND_PORT=8000
# 注意：DATABASE_URL 里的主机名是 compose 服务名 postgres，不是 localhost
DATABASE_URL=postgresql+psycopg://ragkb:changeme@postgres:5432/ragkb

# ── 对象存储（silo，MinIO 社区延续，S3 兼容）──────────────
# ★ MinIO 官方镜像已下架（见 docs/adr/0010），改用 pgsty/silo。
# MINIO_ENDPOINT 里是 compose 服务名 silo；宿主脚本/本机测试会自动
# 替换为 localhost（与 DATABASE_URL 同一套约定，容器内外共用一份 .env）。
MINIO_ENDPOINT=http://silo:9000
MINIO_ROOT_USER=ragkb
MINIO_ROOT_PASSWORD=changeme-minio
MINIO_BUCKET=ragkb
# S3 API 端口（宿主访问）
MINIO_API_PORT=9000
# 控制台端口（浏览器验收用）
MINIO_CONSOLE_PORT=9001

# ── 嵌入（Ollama 本地，V-1）──────────────────────────────
# ★ 企业级真实入库需切换为 TEI（HuggingFace Text Embeddings Inference），
#   原因与切换方式见 app/core/embedding.py 头部说明。
# 宿主脚本连 localhost；backend 容器内将来用 http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# ── 生成模型（LLM 网关 app/core/llm_gateway.py，V-1）─────
# 走 OpenAI 兼容协议 /v1/chat/completions；换云端厂商只改这三个值
# LLM_API_KEY 有值时才发送 Authorization: Bearer 头（Ollama 留空即可）
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen2.5:7b-instruct-q8_0
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=2
# 备用模型降级（可选）：留空 = 禁用；只填 LLM_FALLBACK_MODEL 时
# 地址与 key 自动沿用 LLM_BASE_URL / LLM_API_KEY
LLM_FALLBACK_MODEL=

# ── 评估裁判模型（T29，app/eval/judge.py）────────────────
# 必须与被测模型（LLM_MODEL）**不同且更强一档**
# （evals/judge-prompt.md 使用方式第 5 条：自己判自己 = 分数虚高）。
# 地址/key 沿用 LLM_BASE_URL / LLM_API_KEY（同一 Ollama 实例）。
# 未设置时 make eval 拒绝开始（R7 显式失败）。
#
# ★ 上下文必须 ≥ 8192：judge_v3 提示词约 8.9k 字符，4096 会在提示词中段截断，
#   裁判看不到资料原文却照常打分（Q015 连续四次误判的根因）。
#   本机创建派生模型（只写元数据，复用已有权重，不额外占盘）：
#   printf 'FROM qwen2.5:14b\nPARAMETER num_ctx 8192\n' > /tmp/Modelfile-judge-8k
#   ollama create qwen2.5:14b-8k -f /tmp/Modelfile-judge-8k
JUDGE_MODEL=qwen2.5:14b-8k
